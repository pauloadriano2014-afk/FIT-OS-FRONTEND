{
  "expo": {
    "name": "PA TEAM",
    "slug": "pa-team-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pauloadriano.team"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.pauloadriano.team",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "icon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single",
      "publicPath": "/",
      "splash": {
        "backgroundColor": "#000000",
        "resizeMode": "contain",
        "image": "./assets/icon.png"
      },
      "manifest": {
        "name": "Paulo Adriano Team",
        "short_name": "PA TEAM",
        "description": "Consultoria de Performance",
        "start_url": "./",
        "display": "standalone",
        "orientation": "portrait",
        "background_color": "#000000",
        "theme_color": "#CCFF00"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#CCFF00"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso à câmera para check-in e scanner."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3bb9485f-4a11-490d-a2f8-ed3f0a3778c5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3bb9485f-4a11-490d-a2f8-ed3f0a3778c5"
    }
  }
}